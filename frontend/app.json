{
  "expo": {
    "name": "Ask Elon",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.startproject.i0bl6a",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Dictate your workplace issue to Elon",
        "NSCameraUsageDescription": "Scan contracts and payslips for Elon to check",
        "NSPhotoLibraryUsageDescription": "Add payslip photos for Elon to check"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.startproject.i0bl6a",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/favicon-32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-audio",
        {
          "microphonePermission": "Dictate your workplace issue to Elon"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Scan contracts and payslips for Elon to check",
          "photosPermission": "Add payslip photos for Elon to check"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}