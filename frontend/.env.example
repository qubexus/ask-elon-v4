# ============================================================
#  Ask Elon – ustawienia aplikacji (frontend, Expo)
#  Skopiuj ten plik jako "frontend/.env".
#  Po każdej zmianie tego pliku zatrzymaj aplikację i uruchom ją z czyszczeniem pamięci:
#     npx expo start --web --clear
# ============================================================

# Adres serwera (backendu), BEZ "/api" na końcu.
# - Aplikacja w przeglądarce na tym samym komputerze: http://localhost:8001
# - Aplikacja na telefonie: adres IP komputera w sieci Wi-Fi, np. http://192.168.1.23:8001
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# Logowanie przez Google – identyfikatory klientów OAuth z Google Cloud Console (Credentials).
# Te same identyfikatory wpisz w backend/.env w GOOGLE_CLIENT_IDS.
# Puste = przycisk Google jest ukryty na danej platformie.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# RevenueCat (zakup PRO w App Store / Google Play). Klucze PUBLICZNE z app.revenuecat.com
# -> projekt -> API keys. Puste: aplikacja działa, tylko zakup PRO przez sklep nie zadziała.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Strona www (app.askelon.uk): klucz publiczny RevenueCat Web Billing (rcb_...). Puste = na www zakup przez PayPal.
EXPO_PUBLIC_REVENUECAT_WEB_KEY=
# Klucz TEST (test_...) jest używany tylko w trybie deweloperskim (__DEV__) – nigdy w wersji do sklepu.
