# ============================================================
#  Ask Elon – ustawienia aplikacji (frontend, Expo)
#  Skopiuj ten plik jako "frontend/.env".
#  Po każdej zmianie tego pliku zatrzymaj i uruchom aplikację ponownie.
# ============================================================

# Adres serwera (backendu), BEZ "/api" na końcu.
# - Aplikacja w przeglądarce na tym samym komputerze: http://localhost:8001
# - Aplikacja na telefonie (Expo Go): wpisz adres IP komputera w sieci Wi-Fi,
#   np. http://192.168.1.23:8001 (telefon i komputer w tej samej sieci).
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# RevenueCat (płatności w sklepach Apple/Google, "PRO"). Klucze publiczne z app.revenuecat.com
# -> projekt -> API keys. Możesz zostawić puste: aplikacja się uruchomi,
# tylko zakup PRO przez sklep nie zadziała (w konsoli pojawi się ostrzeżenie "RevenueCat unavailable").
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
