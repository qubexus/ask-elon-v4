# ============================================================
#  Ask Elon – ustawienia serwera (backend)
#  Skopiuj ten plik jako "backend/.env" i wpisz swoje wartości.
#  Pliku .env NIGDY nie wysyłaj nikomu ani nie wrzucaj na GitHuba.
# ============================================================

# Adres bazy danych MongoDB.
# - MongoDB zainstalowane na komputerze:  mongodb://localhost:27017
# - Darmowe MongoDB Atlas: wklej adres "mongodb+srv://..." z panelu Atlas (Connect -> Drivers)
MONGO_URL=mongodb://localhost:27017

# Nazwa bazy danych (dowolna, np. ask_elon)
DB_NAME=ask_elon

# Klucz AI z Emergent (zaczyna się od "sk-emergent-").
# Używany do: czatu z Elonem (Gemini), analizy dokumentów i odcinków wypłat,
# dyktowania głosem (speech-to-text), czytania odpowiedzi (text-to-speech)
# oraz do przechowywania plików w Emergent Object Storage.
# Poza Emergent działa tylko na płatnym planie Emergent i zużywa kredyty Emergent.
# Bez prawdziwego klucza aplikacja się uruchomi, ale czat i dokumenty nie zadziałają.
EMERGENT_LLM_KEY=WPISZ_KLUCZ_EMERGENT_LUB_ZOSTAW

# Hasło do podpisywania logowań (JWT). Wygeneruj własne, długie i losowe, np.:
#   macOS:   openssl rand -hex 32
#   Windows: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=WYGENERUJ_WLASNY_DLUGI_LOSOWY_CIAG

# PayPal (subskrypcja przez stronę). Dopóki w CLIENT_ID jest słowo "placeholder",
# PayPal jest wyłączony, a reszta aplikacji działa normalnie.
# Klucze bierzesz z developer.paypal.com -> Apps & Credentials (najpierw Sandbox).
PAYPAL_CLIENT_ID=placeholder
PAYPAL_SECRET=placeholder
# Sandbox (testy):  https://api-m.sandbox.paypal.com
# Prawdziwe płatności (live): https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# (opcjonalne) Dodatkowe adresy e-mail administratorów, po przecinku.
# jocobisun@gmail.com jest już adminem na stałe w kodzie.
# ADMIN_EMAILS=

# (opcjonalne) Adres serwera integracji Emergent dla plików (Object Storage).
# Domyślnie kod używa https://integrations.emergentagent.com – zwykle nie trzeba ustawiać.
# INTEGRATION_PROXY_URL=
