# ============================================================
#  Ask Elon – ustawienia serwera (backend)
#  Skopiuj ten plik jako "backend/.env" i wpisz swoje wartości
#  (setup.bat / setup.sh robią to same i same wpisują JWT_SECRET).
#  Pliku .env NIGDY nie wysyłaj nikomu ani nie wrzucaj na GitHuba.
# ============================================================

# --- Tryb pracy ---------------------------------------------------------
# development = Twój komputer (kody resetu hasła trafiają też do okna serwera)
# production  = prawdziwy serwer dla użytkowników (ostrzejsze zasady bezpieczeństwa)
APP_ENV=development

# --- Baza danych MongoDB -----------------------------------------------
# - MongoDB zainstalowane na komputerze:  mongodb://localhost:27017
# - Darmowe MongoDB Atlas: wklej adres "mongodb+srv://..." z panelu Atlas (Connect -> Drivers)
MONGO_URL=mongodb://localhost:27017
DB_NAME=ask_elon

# --- Logowanie ----------------------------------------------------------
# Tajny klucz do podpisywania logowań. Długi, losowy, minimum 32 znaki.
# Serwer NIE wystartuje, jeśli zostawisz tu ten napis.
# Wygeneruj:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=WYGENERUJ_WLASNY_DLUGI_LOSOWY_CIAG
# Ile dni jest się zalogowanym bez ponownego logowania
SESSION_DAYS=7

# Administratorzy (panel admina), adresy e-mail po przecinku
ADMIN_EMAILS=jocobisun@gmail.com

# Logowanie przez Google (opcjonalne). Identyfikatory klientów OAuth z Google Cloud Console
# -> APIs & Services -> Credentials. Wpisz WSZYSTKIE (Web, Android, iOS) po przecinku.
# Puste = logowanie Google wyłączone (działa logowanie e-mailem).
GOOGLE_CLIENT_IDS=

# --- Sztuczna inteligencja (Google Gemini) -----------------------------
# Klucz z Google AI Studio: https://aistudio.google.com/apikey
# Używany do: czatu z Elonem, analizy dokumentów i odcinków wypłat, sprawdzania zdjęć,
# dyktowania głosem i czytania odpowiedzi na głos.
# Bez klucza aplikacja działa, ale czat, dokumenty i głos pokażą komunikat "nie skonfigurowano".
GEMINI_API_KEY=
# Modele (można zostawić domyślne)
# (gemini-2.5-flash nie działa już dla nowych kluczy Google)
GEMINI_MODEL=gemini-3.5-flash
# Model zapasowy, gdy główny jest przeciążony (błąd 503 "high demand"). Puste = bez zapasowego.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon
# (opcjonalne) osobne modele do dokumentów i dyktowania; domyślnie = GEMINI_MODEL
# GEMINI_DOC_MODEL=
# GEMINI_STT_MODEL=

# (opcjonalne) Głos przez OpenAI zamiast Gemini. Wpisz klucz i ustaw provider na "openai".
# OPENAI_API_KEY=
# STT_PROVIDER=gemini
# TTS_PROVIDER=gemini

# --- Pliki użytkowników (umowy, payslipy) -------------------------------
# local = pliki w folderze backend/uploads (dobre na komputer i jeden serwer z dyskiem)
# s3    = chmura zgodna z S3 (np. Cloudflare R2, AWS S3) – polecane na produkcję
STORAGE_BACKEND=local
# UPLOAD_DIR=
# Dla STORAGE_BACKEND=s3 (Cloudflare R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- E-mail (kody do resetu hasła) --------------------------------------
# Dane serwera poczty wychodzącej (SMTP), np. od dostawcy skrzynki contact@askelon.uk.
# Port 587 = STARTTLS, port 465 = SSL. Puste = maile nie wychodzą
# (w trybie development kod pojawi się w oknie serwera).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=contact@askelon.uk
MAIL_FROM_NAME=ask Elon

# --- Bezpieczeństwo sieci -----------------------------------------------
# Adresy stron, z których przeglądarka może łączyć się z serwerem (po przecinku).
# Na komputerze zostaw domyślne. Na produkcji wpisz adres aplikacji webowej, np. https://app.askelon.uk
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
# Schematy linków aplikacji mobilnej, do których można wracać po płatności
APP_REDIRECT_SCHEMES=askelon,exp
# Publiczny adres tego serwera (na produkcji, np. https://api.askelon.uk) – używany w linkach PayPal
PUBLIC_BACKEND_URL=
# Ustaw true tylko, jeśli serwer stoi za proxy (np. Cloudflare, Nginx, Render)
TRUST_PROXY=false
# Maksymalny rozmiar jednego wysyłanego pliku/żądania w MB
MAX_REQUEST_MB=25

# --- Podpowiadanie adresu pracodawcy -----------------------------------
# Kod pocztowy -> firmy w pobliżu działa bez klucza (postcodes.io + OpenStreetMap: Photon, zapasowo Overpass).
# Numer firmy (Companies House) -> adres siedziby: darmowy klucz REST z
# https://developer.company-information.service.gov.uk (Your applications -> Create an application -> Live -> Create new key -> REST).
# Puste = pole numeru firmy w aplikacji jest wyłączone z komunikatem "nie jest jeszcze włączone".
COMPANIES_HOUSE_API_KEY=
# (opcjonalne) inne serwery / promień wyszukiwania w metrach
# PHOTON_URL=https://photon.komoot.io
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# LOOKUP_RADIUS_M=600

# --- PayPal (subskrypcja przez stronę) ----------------------------------
# Dopóki w CLIENT_ID jest słowo "placeholder", PayPal jest wyłączony, a reszta aplikacji działa.
# Klucze: developer.paypal.com -> Apps & Credentials (najpierw Sandbox).
PAYPAL_CLIENT_ID=placeholder
PAYPAL_SECRET=placeholder
# Sandbox (testy):  https://api-m.sandbox.paypal.com   Prawdziwe płatności: https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- RevenueCat (subskrypcja PRO z App Store / Google Play / Web Billing) ---------------
# Serwer sam pyta RevenueCat o status PRO użytkownika (app_user_id = user_id z naszej bazy)
# i zapisuje go przy koncie (pole pro_status). Puste = PRO tylko z PayPal / nadane przez admina.
# Klucz TAJNY (sk_...) z app.revenuecat.com -> Project settings -> API keys. NIGDY do frontendu ani do repo.
REVENUECAT_SECRET_KEY=
# ID projektu (proj...). Ustawione = REST API v2 (klucz v2 z uprawnieniem customer_information:customers:read).
# Puste = REST API v1 (klucz v1).
REVENUECAT_PROJECT_ID=
# Identyfikator uprawnienia (entitlement) w RevenueCat
REVENUECAT_ENTITLEMENT_ID=pro
# Wartość nagłówka Authorization ustawiona w RevenueCat -> Integrations -> Webhooks.
# Webhook: https://app.askelon.uk/api/billing/revenuecat/webhook  (puste = webhook wyłączony, odpowiada 401)
REVENUECAT_WEBHOOK_AUTH=
# Opcjonalnie: sekret podpisu HMAC webhooka (X-RevenueCat-Webhook-Signature)
REVENUECAT_WEBHOOK_HMAC_SECRET=
# 1 = zakupy testowe (sandbox / Test Store) dają PRO. Domyślnie: tak w development, nie na produkcji.
REVENUECAT_ALLOW_SANDBOX=
# Ile minut ufać zapisanemu statusowi, zanim serwer sprawdzi go ponownie
REVENUECAT_CACHE_MINUTES=10
